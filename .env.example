# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI
VOYAGE_API_KEY=pa-...

# Cohere
COHERE_API_KEY=...

# Tavily
TAVILY_API_KEY=tvly-...

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=...

# Qdrant Cloud
QDRANT_URL=https://<cluster>.qdrant.io
